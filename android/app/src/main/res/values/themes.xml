<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.DigitalSignage" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/signage_accent</item>
        <item name="colorPrimaryDark">@color/signage_background</item>
        <item name="colorAccent">@color/signage_accent</item>
        <item name="android:textColorPrimary">@color/signage_text_primary</item>
        <item name="android:textColorSecondary">@color/signage_text_muted</item>
        <item name="android:windowBackground">@color/signage_background</item>
        <item name="android:colorBackground">@color/signage_background</item>
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
    </style>

    <style name="Theme.DigitalSignage.Splash" parent="Theme.DigitalSignage">
        <item name="android:windowBackground">@color/signage_background</item>
    </style>

    <!-- Maintenance dialog: no title bar, transparent window so the card drawable shows. -->
    <style name="Theme.DigitalSignage.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="colorAccent">@color/signage_accent</item>
        <item name="android:textColorPrimary">@color/signage_text_primary</item>
    </style>
</resources>
