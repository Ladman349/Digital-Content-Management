<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signage_background">

    <!-- Everything inside this container is rotated together by applyOrientation(). -->
    <FrameLayout
        android:id="@+id/playbackRootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="texture_view" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- ==================== Status screen ==================== -->
        <FrameLayout
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/signage_background"
            android:visibility="visible">

            <!-- Brand mark + wordmark, top-left -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/signage_screen_padding">

                <ImageView
                    android:id="@+id/imgBrandMark"
                    android:layout_width="@dimen/signage_brand_mark_size"
                    android:layout_height="@dimen/signage_brand_mark_size"
                    android:contentDescription="@string/brand_mark_content_description"
                    android:src="@drawable/ic_brand_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/signage_gap"
                    android:text="@string/brand_wordmark"
                    style="@style/Text.Signage.Wordmark" />
            </LinearLayout>

            <!-- Centred status card -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:minWidth="@dimen/signage_status_card_min_width"
                style="@style/Widget.Signage.Card">

                <!-- Indicator: indeterminate spinner while busy, static icon otherwise -->
                <FrameLayout
                    android:layout_width="@dimen/signage_status_indicator_size"
                    android:layout_height="@dimen/signage_status_indicator_size"
                    android:layout_marginBottom="@dimen/signage_gap_large">

                    <ProgressBar
                        android:id="@+id/statusSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/signage_accent"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/status_indicator_content_description"
                        android:src="@drawable/ic_status_waiting"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatusPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_booting_title"
                    style="@style/Text.Signage.StatusPrimary" />

                <TextView
                    android:id="@+id/tvStatusSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/signage_gap"
                    android:maxWidth="800dp"
                    android:text="@string/status_booting_subtitle"
                    style="@style/Text.Signage.StatusSecondary" />

                <!-- Determinate bar; visible only while downloading -->
                <ProgressBar
                    android:id="@+id/pbDownloadProgress"
                    android:layout_width="@dimen/signage_progress_width"
                    android:layout_height="@dimen/signage_progress_height"
                    android:layout_marginTop="@dimen/signage_gap_large"
                    android:progress="0"
                    android:visibility="gone"
                    style="@style/Widget.Signage.ProgressBar.Determinate" />
            </LinearLayout>

            <!-- Identity bar, bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/signage_screen_padding"
                android:paddingEnd="@dimen/signage_screen_padding"
                android:paddingTop="@dimen/signage_gap"
                android:paddingBottom="@dimen/signage_screen_padding">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/signage_gap_large"
                    android:text="@string/identity_device_name_unknown"
                    style="@style/Text.Signage.Footer" />

                <TextView
                    android:id="@+id/tvDeviceIdChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/signage_gap_large"
                    android:text="@string/identity_device_id_placeholder"
                    style="@style/Text.Signage.DeviceIdChip" />

                <TextView
                    android:id="@+id/tvDeviceIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/signage_gap_large"
                    android:text="@string/identity_ip_unknown"
                    style="@style/Text.Signage.Footer" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Text.Signage.Footer" />

                <View
                    android:id="@+id/viewOnlineDot"
                    android:layout_width="@dimen/signage_status_dot_size"
                    android:layout_height="@dimen/signage_status_dot_size"
                    android:layout_marginEnd="@dimen/signage_gap_small"
                    android:background="@drawable/dot_status_offline" />

                <TextView
                    android:id="@+id/tvOnlineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/identity_offline"
                    style="@style/Text.Signage.Footer" />
            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/signage_accent"
        android:visibility="gone" />

    <!-- DEBUG-only diagnostics / exception panel -->
    <ScrollView
        android:id="@+id/debugExceptionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/signage_scrim"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/debug_panel_title"
                android:textColor="@color/signage_error"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyDiagnostics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/debug_copy_report"
                    style="@style/Widget.Signage.Button" />

                <Button
                    android:id="@+id/btnSaveDiagnostics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/debug_save_report"
                    style="@style/Widget.Signage.Button" />

                <Button
                    android:id="@+id/btnTriggerInstall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_trigger_install"
                    style="@style/Widget.Signage.Button" />
            </LinearLayout>

            <TextView android:id="@+id/tvDebugState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_primary" android:textSize="16sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvDebugCommand" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_primary" android:textSize="16sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvDebugBaseUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_primary" android:textSize="16sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvDebugCleartext" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_primary" android:textSize="16sp" android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/debug_exception_details"
                android:textColor="@color/signage_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView android:id="@+id/tvDebugExceptionClass" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_error" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvDebugExceptionMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_primary" android:textSize="16sp" android:textStyle="italic" android:layout_marginBottom="12dp" />
            <TextView android:id="@+id/tvDebugExceptionTrace" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/signage_text_muted" android:textSize="12sp" android:fontFamily="monospace" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
