<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/signage_chip_background" />
            <corners android:radius="@dimen/signage_chip_radius" />
            <stroke
                android:width="@dimen/signage_focus_stroke"
                android:color="@color/signage_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/signage_chip_background" />
            <corners android:radius="@dimen/signage_chip_radius" />
            <stroke
                android:width="@dimen/signage_card_stroke"
                android:color="@color/signage_card_border" />
        </shape>
    </item>
</selector>
