<?xml version="1.0" encoding="utf-8"?>
<!-- The bench: a lifted slat with the amber rule along its top, the same shape the CMS uses for detail. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/signage_card" />
            <corners android:radius="@dimen/signage_card_radius" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="@dimen/signage_card_accent">
        <shape android:shape="rectangle">
            <solid android:color="@color/signage_accent" />
        </shape>
    </item>
</layer-list>
