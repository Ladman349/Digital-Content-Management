# Environment Configuration (development, production)
APP_ENV=development

# Database Connection (local PostgreSQL or Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:121@localhost:5432/postgres

# Supabase Storage Configurations (leave empty to fallback to local uploads storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Bucket holding player APKs for over-the-air updates. Without Supabase configured, APKs are
# written to local disk and are lost on every redeploy.
SUPABASE_APK_BUCKET=apks
OTA_MAX_UPLOAD_MB=150

# Public API endpoints and CORS configuration
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application Secrets (Must be changed in production mode)
SECRET_KEY=super-secret-key-change-in-production

# ── Authentication (both opt-in, see DEPLOYMENT.md "Securing the API") ────────────────────
# People sign in with their own accounts. Sign-in switches on when the first administrator is
# created: from the CMS Accounts page, with `python manage_users.py create-admin`, or by setting the
# two BOOTSTRAP_ variables below for one start (they only act while no user exists; remove the
# password afterwards). Until then anyone who can reach the API can manage every screen.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Days a CMS sign-in lasts without being used.
SESSION_TTL_DAYS=30

# Optional platform-administrator key for scripts and support tooling (X-Admin-Key header).
ADMIN_API_KEY=

# Requires players to send their device token. Enable ONLY after every screen in the field runs a
# build that sends its real token; a device that cannot authenticate also cannot download the OTA
# update that would fix it.
REQUIRE_DEVICE_AUTH=false
