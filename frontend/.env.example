# Backend API connection endpoint. The /api/v1 suffix is appended automatically when omitted.
VITE_API_URL=http://localhost:8000/api/v1

# Legacy shared admin key from before user accounts. Leave it unset: people sign in now, and a key
# baked into the bundle is readable by anyone who loads the CMS, which would make every visitor an
# administrator regardless of the sign-in screen. See DEPLOYMENT.md, Section 6.
# VITE_ADMIN_API_KEY=
