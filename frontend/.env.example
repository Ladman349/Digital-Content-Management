# Backend API connection endpoint. The /api/v1 suffix is appended automatically when omitted.
VITE_API_URL=http://localhost:8000/api/v1

# Shared admin key, required only when the backend has ADMIN_API_KEY set. Must match it exactly.
# This is a deployment-level guard, not user authentication: anything in the bundle is readable by
# anyone who can load the CMS, so keep the CMS itself behind SSO or a VPN.
# VITE_ADMIN_API_KEY=
